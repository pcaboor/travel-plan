POSTGRES_DB=travel_plan
POSTGRES_USER=travel_plan
POSTGRES_PASSWORD=change_me_postgres

NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

ADMIN_DATABASE_URL=jdbc:postgresql://postgres:5432/travel_plan
ADMIN_DATABASE_USERNAME=travel_plan
ADMIN_DATABASE_PASSWORD=change_me_postgres

TRAVEL_NEO4J_URI=bolt://neo4j:7687
TRAVEL_NEO4J_DATABASE=neo4j

STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

PAYMENT_DATABASE_URL=jdbc:postgresql://postgres:5432/travel_plan
PAYMENT_DATABASE_USERNAME=travel_plan
PAYMENT_DATABASE_PASSWORD=change_me_postgres

SONARQUBE_JDBC_USERNAME=sonar
SONARQUBE_JDBC_PASSWORD=change_me_sonar
SONARQUBE_JDBC_DATABASE=sonarqube

JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change_me_jenkins

# JWT must be at least 32 bytes long (HS256 requirement)
JWT_SECRET=change-me-please-use-32-bytes-or-more-secret-xxxx
JWT_ISSUER=travelplan-auth
JWT_ACCESS_TTL_MINUTES=60

AUTH_DATABASE_URL=jdbc:postgresql://postgres:5432/travel_plan
AUTH_DATABASE_USERNAME=travel_plan
AUTH_DATABASE_PASSWORD=change_me_postgres

ADMIN_BOOTSTRAP_EMAIL=admin@travelplan.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

CORS_ALLOWED_ORIGINS=https://localhost:5443,http://localhost:5173

# Path on the host to mount as /etc/nginx/certs/external in the dashboard
# container. Drop server.crt/server.key here in production to override the
# self-signed cert generated at build time. Leave the default for dev.
TLS_CERT_DIR=./tls-certs

# Vault dev mode root token. Used by the vault-init container to seed
# secret/data/travelplan/* and by every Spring service to read them at boot.
VAULT_ROOT_TOKEN=travelplan-root-token

# Grafana admin credentials (Loki UI).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
